// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/types/prisma"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id Int @id @default(autoincrement())

  identifier  Int       @unique
  model       String
  year        String
  capacity    Int
  doors       Int
  uf          String
  plateType   PlateType
  plate       String
  renavam     String    @unique
  chassi      String    @unique
  review      Int
  description String?
  photos      String[]

  gas        Gas      @relation(fields: [gasId], references: [id])
  gasId      Int
  brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id Int @id @default(autoincrement())

  name     String
  cnpj     String    @unique
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id Int @id @default(autoincrement())

  name     String    @unique
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id Int @id @default(autoincrement())

  name String @unique

  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gas {
  id Int @id @default(autoincrement())

  type String

  vehicle     Vehicle[]
  gasSupplies GasSupply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Documentation {
  id Int @id @default(autoincrement())

  type              String
  expiryAt          DateTime
  anticipateRenewal Boolean  @default(false)
  days              String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Occurrence {
  id Int @id @default(autoincrement())

  date        DateTime
  description String

  seriousness      Seriousness    @relation(fields: [seriousnessId], references: [id])
  seriousnessId    Int
  classification   Classification @relation(fields: [classificationId], references: [id])
  classificationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classification {
  id Int @id @default(autoincrement())

  description String
  occurences  Occurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seriousness {
  id Int @id @default(autoincrement())

  level String

  occurences Occurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GasSupply {
  id Int @id @default(autoincrement())

  kmToReview Int
  kmToStop   Int
  quantity   Float
  supplyAt   DateTime
  totalPrice Float

  gas   Gas @relation(fields: [gasId], references: [id])
  gasId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GasStation {
  id Int @id @default(autoincrement())

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Status {
  id Int @id @default(autoincrement())

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlateType {
  MERCOSUL
  OUTRO
}
