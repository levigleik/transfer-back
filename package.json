{
	"name": "transfer",
	"version": "1.0.0",
	"description": "Transfer Pass",
	"author": "levigleik",
	"license": "ISC",
	"type": "module",
	"scripts": {
		"build": "bunx tsc --project tsconfig.json && bunx tsc-alias -p tsconfig.json",
		"dev": "bun run --env-file=.env.development --watch src/index.ts",
		"dev:swagger": "bun run --env-file=.env.development --watch scripts/swagger.ts",
		"generate:module": "node scripts/generateModules.mjs",
		"lint": "npx biome format --write . && biome lint",
		"start": "bun run dist/src/index.js",
		"start:bun": "bun run dist/src/index.js",
		"swagger:prod": "bun run scripts/swagger.prod.ts",
		"test": "bun run --env-file=.env.test npx jest --detectOpenHandles --runInBand",
		"prisma_studio:test": "bun run --env-file=.env.test bunx prisma studio",
		"prisma_studio:dev": "bun run --env-file=.env.development bunx prisma studio",
		"prisma_studio:docker": "bun run --env-file=.env.docker bunx prisma studio",
		"prisma_studio:prod": "bun run --env-file=.env.production bunx prisma studio",
		"prisma_migrate:dev": "bun run --env-file=.env.development bunx prisma migrate dev",
		"prisma_deploy:dev": "bun run --env-file=.env.development bunx prisma migrate deploy",
		"prisma_deploy:prod": "bun run --env-file=.env.production bunx prisma migrate deploy",
		"prisma_deploy:docker": "bun run --env-file=.env.docker bunx prisma migrate deploy",
		"prisma_reset:docker": "bun run --env-file=.env.docker bunx prisma migrate reset",
		"prisma_reset:dev": "bun run --env-file=.env.development bunx prisma migrate reset"
	},
	"prisma": {
		"seed": "bun run prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.16.3",
		"@scalar/express-api-reference": "^0.8.22",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"express-async-errors": "^3.1.1",
		"ioredis": "^5.8.1",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.1.1",
		"pino": "^10.0.0",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.2",
		"swagger-autogen": "^2.23.7",
		"tsconfig-paths": "^4.2.0",
		"uuidv7": "^1.0.2",
		"zod": "^4.1.12",
		"zod-to-json-schema": "^3.24.6"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@faker-js/faker": "^9.9.0",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "^1.2.23",
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.1",
		"@types/glob": "^9.0.0",
		"@types/ioredis": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/json-schema": "^7.0.15",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^2.0.0",
		"@types/node": "^22.13.11",
		"@types/pino": "^7.0.5",
		"@types/pino-http": "^6.1.0",
		"@types/pino-pretty": "^5.0.0",
		"@types/supertest": "^6.0.2",
		"@types/swagger-ui-express": "^4.1.8",
		"glob": "^13.0.6",
		"jest": "^30.2.0",
		"prisma": "^6.16.3",
		"prisma-test-utils": "^0.4.1",
		"prisma-zod-generator": "^1.27.3",
		"supertest": "^7.1.0",
		"swagger-ui-express": "^5.0.1",
		"ts-jest": "^29.4.5",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3"
	}
}
